# Environment Configuration Example
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
# If left empty, embedded PGlite is used with persistence in .pglite_data
DATABASE_URL=

# JWT Authentication
JWT_SECRET=your-random-secure-jwt-secret-here
JWT_EXPIRES_IN=7d

# App Settings
NEXT_PUBLIC_APP_NAME="Apex Enterprise LMS"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=rzp_secret_sample
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_sample
